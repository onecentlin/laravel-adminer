{
    "name": "iamashishk/laravel-adminer",
    "description": "Laravel Adminer Database Manager",
    "keywords": [
        "laravel5",
        "laravel6",
        "laravel7",
        "laravel8",
        "laravel9",
        "laravel10",
        "laravel11",
        "laravel12",
        "laravel13",
        "adminer",
        "database",
        "management",
        "mysql",
        "sqlite"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ashish Kohli",
            "email": "developergurugram@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4.0",
        "illuminate/contracts": "~5.0|~6.0|~7.0|~8.0|~9.0|~10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "~5.0|~6.0|~7.0|~8.0|~9.0|~10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "~5.0|~6.0|~7.0|~8.0|~9.0|~10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Iamashishk\\Adminer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Iamashishk\\Adminer\\ServiceProvider"
            ]
        }
    },
    "config": {
        "preferred-install": "dist"
    },
    "minimum-stability": "stable"
}
